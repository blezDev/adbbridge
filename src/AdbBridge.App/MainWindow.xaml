<Window x:Class="AdbBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdbBridge" Height="860" Width="1080" WindowStartupLocation="CenterScreen"
        MinHeight="640" MinWidth="840" Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource InkBrush}" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#E8EEFF" BorderBrush="#C8D7FF"
                BorderThickness="0,0,0,1" Padding="24,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="UpdateDismissButton" Content="Dismiss" DockPanel.Dock="Right" Padding="8,2"
                        Margin="6,0,0,0" Click="UpdateDismissButton_Click"/>
                <Button x:Name="UpdateDownloadButton" Content="Update and restart" DockPanel.Dock="Right" Padding="8,2"
                        Click="UpdateDownloadButton_Click"/>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Text="An update is available."/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="ViewHost"/>
    </DockPanel>
</Window>
