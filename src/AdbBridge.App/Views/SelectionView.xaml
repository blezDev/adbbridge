<UserControl x:Class="AdbBridge.App.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <TextBlock Text="AdbBridge" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="What is this PC?" FontSize="14" Foreground="#666" Margin="0,4,0,28" HorizontalAlignment="Center"/>

            <Button x:Name="HostButton" Padding="16" Margin="0,0,0,14" Click="HostButton_Click" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Host" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="This PC — the phone is plugged into it over USB." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="CompanionButton" Padding="16" Click="CompanionButton_Click" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Companion" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="This PC — Android Studio runs here and needs to see the phone." TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <TextBlock x:Name="VersionText" Text="AdbBridge" Foreground="#999" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="#999" VerticalAlignment="Center"/>
                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="#2563EB" Cursor="Hand" Click="CheckUpdatesButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
