<UserControl x:Class="AdbBridge.App.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24" MaxWidth="1200">
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="←  Switch role" Style="{StaticResource QuietButton}" Click="BackButton_Click" Margin="0,0,20,0"/>
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource RoleBadge}"><TextBlock Text="HOST" Style="{StaticResource Eyebrow}"/></Border>
                <TextBlock Text="AdbBridge" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Share your Android device" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Keep your phone plugged in here. Connect to it from your other workspace." Style="{StaticResource Hint}" Margin="0,6,0,24"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Set up sharing" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Choose a tunnel provider to connect your PCs." Style="{StaticResource Hint}" Margin="0,8,0,20"/>
                            <TextBlock Text="Tunnel provider" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProviderCombo" Margin="0,0,0,18" SelectionChanged="ProviderCombo_SelectionChanged" AutomationProperties.Name="Tunnel provider"><ComboBoxItem Content="ngrok" Tag="Ngrok"/><ComboBoxItem Content="Pinggy" Tag="Pinggy"/></ComboBox>
                            <StackPanel x:Name="NgrokPanel">
                                <TextBlock Text="ngrok access token" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="AuthTokenBox" AutomationProperties.Name="ngrok access token"/>
                                <TextBlock Text="Find your token in the ngrok dashboard." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,12"/>
                                <TextBlock Text="ngrok.exe" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NgrokPathBox" FontSize="11" AutomationProperties.Name="ngrok executable path"/>
                                <Button x:Name="BrowseNgrokButton" Content="Browse for ngrok.exe" Click="BrowseNgrokButton_Click" Margin="0,8,0,0"/>
                                <TextBlock x:Name="NgrokAvailabilityText" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
                                <Button x:Name="DownloadNgrokButton" Content="Get ngrok ↗" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="DownloadNgrokButton_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel x:Name="PinggyPanel" Visibility="Collapsed">
                                <TextBlock Text="Pinggy access token" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="PinggyTokenBox" AutomationProperties.Name="Pinggy access token"/>
                                <TextBlock Text="A Pro token keeps the same sharing address." Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,12"/>
                                <Expander Header="OpenSSH location">
                                    <StackPanel><TextBox x:Name="SshPathBox" FontSize="11" AutomationProperties.Name="SSH executable path"/><Button x:Name="BrowseSshButton" Content="Browse for ssh.exe" Click="BrowseSshButton_Click" Margin="0,8,0,0"/></StackPanel>
                                </Expander>
                            </StackPanel>
                            <Expander x:Name="AdbSettingsExpander" Header="Android SDK settings" Margin="0,12,0,12">
                                <StackPanel><TextBlock Text="ADB executable (platform-tools)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AdbPathBox" FontSize="11" AutomationProperties.Name="ADB executable path"/><Button x:Name="BrowseAdbButton" Content="Browse for adb.exe" Click="BrowseAdbButton_Click" Margin="0,8,0,0"/></StackPanel>
                            </Expander>
                            <Button x:Name="StartStopButton" Content="Start sharing" Style="{StaticResource PrimaryButton}" Click="StartStopButton_Click"/>
                            <ProgressBar x:Name="SharingProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,18"><StackPanel><TextBlock Text="Make it automatic" FontWeight="SemiBold" Margin="0,0,0,6"/><CheckBox x:Name="RunAtStartupCheck" Content="Launch at Windows startup" Checked="RunAtStartupCheck_Changed" Unchecked="RunAtStartupCheck_Changed"/></StackPanel></Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel><TextBlock Text="Sharing status" Style="{StaticResource SectionTitle}"/><Ellipse x:Name="SharingIndicator" Width="9" Height="9" Fill="#A6B2C5" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                            <Border x:Name="SharingStatusCard" Background="#F3F6FB" CornerRadius="10" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="AdbStatusText" Text="ADB server: stopped" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="TunnelStatusText" Text="Tunnel: stopped" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <TextBlock Text="Paste this address into AdbBridge on your Companion PC." Style="{StaticResource Hint}" FontSize="12" Margin="0,14,0,18"/>
                            <TextBox x:Name="PublicAddressBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15" Text="Waiting for sharing to start" AutomationProperties.Name="Public sharing address"/>
                            <Button x:Name="CopyAddressButton" Content="Copy sharing address" Click="CopyAddressButton_Click" IsEnabled="False" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16"><TextBlock Text="Devices" Style="{StaticResource SectionTitle}"/><TextBlock Text="LIVE" Style="{StaticResource LiveLabel}"/></DockPanel>
                            <Grid MinHeight="170">
                                <ListView x:Name="DeviceListView" ItemTemplate="{StaticResource DeviceTemplate}" MaxHeight="250" AutomationProperties.Name="Local Android devices"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DeviceListView}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="Waiting for your phone" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Connect via USB, enable USB debugging,&#10;and accept the prompt on your phone." Style="{StaticResource Hint}" FontSize="12" TextAlignment="Center" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,8"><Expander Header="Activity log · connection diagnostics"><ListBox x:Name="LogListBox" Style="{StaticResource LogList}"/></Expander></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
